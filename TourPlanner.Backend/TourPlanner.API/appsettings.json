{
  "ConnectionStrings": {
    "TourPlannerDb": ""
  },
  "Storage": {
    "BaseDirectory": ""
  },
  "OpenRouteService": {
    "ApiKey": "",
    "BaseUrl": "https://api.openrouteservice.org"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "TourPlanner",
    "Audience": "TourPlannerClient",
    "ExpiryMinutes": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tourplanner-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}